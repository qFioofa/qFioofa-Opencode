  "tool_output": {
    "max_lines": 600,
    "max_bytes": 30000,
  },
  "subagent_depth": 1,
  // Optional token-pruning plugin. Enable after verifying it works with your
  // opencode version: "plugin": ["@tarquinen/opencode-dcp"],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "git push*": "ask",
      "kamal deploy*": "ask",
      "kamal setup*": "deny",
      "terraform apply*": "deny",
      "kubectl delete*": "deny",
    },
  },
  "agent": {
    "explore": {
      "model": "omniroute/opencode-go/glm-5.3-flash",
      "steps": 15,
    },
    "title": {
      "model": "omniroute/ollamacloud/gemma4:31b",
    },
    "summary": {
      "model": "omniroute/ollamacloud/gemma4:31b",
    },
    "compaction": {
      "model": "omniroute/ollamacloud/gemma4:31b",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "pg-docs": {
      "type": "remote",
      "url": "https://mcp.tigerdata.com/docs",
      "enabled": true,
    },
  },
  "compaction": {
    "auto": true,
    "reserved": 10000,
  },
}
