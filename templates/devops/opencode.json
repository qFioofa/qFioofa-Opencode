{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "docker compose down -v*": "ask",
      "docker system prune*": "ask",
      "kamal setup*": "deny",
      "kamal deploy*": "ask",
      "terraform apply*": "deny",
      "terraform destroy*": "deny",
      "kubectl delete*": "deny",
      "git push*": "ask",
    },
  },
}
