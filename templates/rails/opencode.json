{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "rails": {
      "type": "local",
      "command": ["rails-mcp-server"],
      "enabled": false,
    },
    "pg-docs": {
      "type": "remote",
      "url": "https://mcp.tigerdata.com/docs",
      "enabled": true,
    },
    "postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted",
      ],
      "environment": {
        "DATABASE_URI": "{env:DATABASE_URI}",
      },
      "enabled": false,
    },
  },
  "agent": {
    "rails-dev": {
      "mode": "subagent",
      "description": "Rails implementation: models, controllers, services, migrations, tests",
      "model": "omniroute/opencode-go/kimi-k2.7-code",
      "temperature": 0.2,
      "steps": 40,
    },
  },
}
